generator client {
  provider = "prisma-client"
  output   = "../prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  Follow
  Empathy
  Reply
  LimitedFromPosting
  PostDeleted
  System
}

enum ProfilePrivacyType {
  Public
  UsersOnly
}

/// User
model User {
  pid            Int      @id
  pnid           String?
  pnidNormalized String?  @map("pnid_normalized")
  createdAt      DateTime @default(now()) @map("created_at")
  displayName    String   @map("display_name")
  lastSeen       DateTime @map("last_seen")

  // TODO refactor bans to different table so it keeps a history
  accountStatus Int       @map("account_status")
  banReason     String?   @map("ban_reason")
  banEndsAt     DateTime? @map("ban_ends_at")
  bannedBy      Int?      @map("banned_by")

  settings            UserSetting?
  follows             UserFollow[]      @relation("follows")
  followers           UserFollow[]      @relation("followers")
  followedCommunities CommunityFollow[]

  @@map("users")
}

/// User settings
model UserSetting {
  pid  Int  @id @unique
  user User @relation(fields: [pid], references: [pid], onDelete: Cascade)

  receiveNotifications        Boolean            @map("receive_notifications")
  profilePrivacy              ProfilePrivacyType @map("profile_privacy")
  isFavouriteCommunityVisible Boolean            @map("is_favourite_community_visible")
  isCountryVisible            Boolean            @map("is_country_visible")
  isRelationshipVisible       Boolean            @map("is_relationship_visible")
  isBirthdayVisible           Boolean            @map("is_birthday_visible")
  isGameSkillVisible          Boolean            @map("is_game_skill_visible")

  notifyFollows Boolean @map("notify_follows")
  notifyEmpathy Boolean @map("notify_empathy")
  notifyReply   Boolean @map("notify_reply")

  profileComment String? @map("profile_comment")
  gameSkill      Int     @map("game_skill")

  @@map("user_settings")
}

/// User Follow
model UserFollow {
  pid          Int
  followingPid Int @map("following_pid")

  user          User @relation(name: "follows", fields: [pid], references: [pid], onDelete: Cascade)
  followingUser User @relation(name: "followers", fields: [followingPid], references: [pid], onDelete: Cascade)

  @@id([pid, followingPid])
  @@map("user_follows")
}

/// Community Follow
model CommunityFollow {
  pid         Int
  communityId String @map("community_id")

  user User @relation(fields: [pid], references: [pid], onDelete: Cascade)

  @@id([pid, communityId])
  @@map("community_follows")
}

/// Notification content
model Notification {
  id      String           @id
  type    NotificationType
  content Json /// Any extra context, dependent on type. Like users who followed

  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  notificationRecipients NotificationRecipient[]

  @@map("notifications")
}

/// Received notification
model NotificationRecipient {
  id      String  @id
  pid     Int
  hasRead Boolean @default(false) @map("has_read")

  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([pid])
  @@map("notification_recipients")
}

/// Maps an OpenPak account (web sign-in) to the numeric id the rest of this service is keyed by.
/// A Wii U-linked account uses its real PID; a web-only account gets a number from the sequence
/// below, which starts above the highest PID nn-account ever hands out (1799999999).
model WebIdentity {
  accountId       String    @id @map("account_id")
  pid             Int       @unique @default(autoincrement())
  linked          Boolean   @default(false)
  rulesAcceptedAt DateTime? @map("rules_accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("web_identities")
}

/// A console that was linked to an OpenPak account with a short code (OpenVerse Lite on the PS3, Wii and
/// DSi browsers, and the Xbox 360 feed). Only the SHA-256 of the token is stored; the token itself
/// lives on the device. Revoked rows are kept so the list can say so.
model DeviceLink {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  /// ps3 | wii | dsi | x360 | lite
  deviceClass String    @map("device_class")
  label       String
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([accountId])
  @@map("device_links")
}


/// Opt-in automatic activity posts (a badge earned, a course uploaded...). Off by default; keyed by the
/// OpenPak account like web_identities. `categories` holds the switched-on category ids.
model ActivitySetting {
  accountId  String   @id @map("account_id")
  enabled    Boolean  @default(false)
  categories String[] @default([])
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("activity_settings")
}

/// One moment reported by a game server or the rewards service. `eventId` is the idempotency key.
/// A moment past the daily limit or inside a burst is stored `folded` (so a retry stays a duplicate)
/// and counted in that day's single digest row (`digest`, `count` = moments in it).
model ActivityPost {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique @map("event_id")
  accountId String   @map("account_id")
  category  String
  subject   String   @default("")
  link      String   @default("")
  image     String   @default("")
  digest    Boolean  @default(false)
  folded    Boolean  @default(false)
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@index([createdAt])
  @@map("activity_posts")
}

// ---------------------------------------------------------------------------------------------
// Moved from MongoDB (card openpak/prds#20). Field names keep the snake_case names the Mongo
// documents had, so the route code and the console wire format read the same fields as before.
// `legacy_mongo_id` is the old ObjectId (hex), set only on imported rows; it makes the one-shot
// import (migrations/11-mongo-to-pg) safe to run again.
// ---------------------------------------------------------------------------------------------

enum CommunityShotMode {
  allow
  block
  force
}

/// A community (a game, a sub-community a player made, an announcement room or a family page).
/// `community_id` is the console-facing id, `olive_community_id` the 64-bit one posts point at.
model Community {
  community_id       String  @id
  olive_community_id String  @unique
  legacy_mongo_id    String? @unique

  platform_id     Int
  name            String
  description     String
  open            Boolean @default(true)
  allows_comments Boolean @default(true)
  /// 0 main, 1 sub (or family page), 2 announcement, 3 private
  type            Int     @default(0)
  parent          String?
  admins          Int[]   @default([])
  owner           Int?
  created_at      DateTime @default(now())
  empathy_count   Int     @default(0)
  has_shop_page   Int     @default(0)
  /// TGA icon blob, base64 (console wire format)
  icon            String
  ctr_header      String?
  wup_header      String?
  /// CDN paths of the rendered icon sizes; all five set or all null
  icon_path_32    String?
  icon_path_48    String?
  icon_path_64    String?
  icon_path_96    String?
  icon_path_128   String?
  title_id        String[] @default([])
  is_recommended  Int     @default(0)
  app_data        String  @default("")
  user_favorites  Int[]   @default([])

  permissions_open                   Boolean @default(true)
  minimum_new_post_access_level      Int     @default(0)
  minimum_new_comment_access_level   Int     @default(0)
  minimum_new_community_access_level Int     @default(3)

  shot_mode           CommunityShotMode @default(allow)
  shot_extra_title_id String[]          @default([])

  /// A franchise family page made by `npm run db:sync-families` (its games carry its id as parent)
  family  Boolean @default(false)
  /// Art bookmark of `npm run db:sync-games`
  art_sha String?

  @@index([parent, type])
  @@index([type, created_at])
  @@index([owner])
  @@index([title_id], type: Gin)
  @@index([user_favorites], type: Gin)
  @@map("communities")
}

/// A post, a reply (parent set) or a console private message (message_to_pid set, community_id
/// is then the conversation id). Only the author's pid is kept: the name and Mii the wire format
/// carries per post are read from the account core when the post is served (services/identity),
/// and the face image URL follows from pid and feeling_id.
model Post {
  id              String  @id
  legacy_mongo_id String? @unique

  title_id      String?
  body          String  @default("")
  body_markdown String?
  app_data      String?

  painting          String?
  painting_img      String?
  painting_big      String?
  screenshot        String?
  screenshot_big    String?
  screenshot_thumb  String?
  screenshot_length Int?
  screenshot_aspect String?

  search_key String[] @default([])
  topic_tag  String?

  community_id String
  created_at   DateTime
  feeling_id   Int?

  is_autopost                   Int @default(0)
  is_community_private_autopost Int @default(0)
  is_spoiler                    Int @default(0)
  is_app_jumpable               Int @default(0)

  empathy_count Int @default(0)
  /// The console's country and the language the post was written in (Olive param pack, per post)
  country_id    Int @default(49)
  language_id   Int @default(1)

  pid         Int
  platform_id Int?
  region_id   Int?
  parent      String?

  reply_count Int     @default(0)
  verified    Boolean @default(false)

  /// The recipient pid of a private message, as text (the Mongo documents stored it so)
  message_to_pid String?

  removed        Boolean   @default(false)
  removed_reason String?
  removed_by     Int?
  removed_at     DateTime?

  yeahs Int[] @default([])

  @@index([community_id, removed, parent, created_at(sort: Desc)])
  @@index([parent, removed, created_at(sort: Desc)])
  @@index([pid, message_to_pid, parent, removed, created_at(sort: Desc)])
  @@index([topic_tag, message_to_pid, parent, removed, created_at(sort: Desc)])
  @@index([message_to_pid, created_at])
  @@index([created_at])
  @@index([yeahs], type: Gin)
  @@index([search_key], type: Gin)
  @@map("posts")
}

/// A console private-message conversation between two players
model Conversation {
  id              String  @id
  legacy_mongo_id String? @unique

  created_at      DateTime @default(now())
  last_updated    DateTime @default(now())
  message_preview String   @default("")

  users ConversationUser[]

  @@map("conversations")
}

model ConversationUser {
  conversation_id String
  pid             Int
  official        Boolean @default(false)
  read            Boolean @default(true)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, pid])
  @@index([pid])
  @@map("conversation_users")
}

/// Discovery data, one row per server access level (seeded by `npm run db:seed`)
model Endpoint {
  id                  Int     @id @default(autoincrement())
  legacy_mongo_id     String? @unique
  status              Int     @default(0)
  server_access_level String  @unique
  topics              Boolean @default(false)
  guest_access        Boolean @default(false)
  new_users           Boolean @default(true)
  host                String  @default("")
  api_host            String  @default("")
  portal_host         String  @default("")
  n3ds_host           String  @default("")

  @@map("endpoints")
}

/// A player's report of a post
model Report {
  /// The old ObjectId hex for imported rows, a uuid for new ones
  id              String  @id @default(uuid())
  legacy_mongo_id String? @unique

  pid         Int
  reported_by Int
  post_id     String
  reason      Int
  message     String    @default("")
  created_at  DateTime  @default(now())
  resolved    Boolean   @default(false)
  note        String?
  resolved_by Int?
  resolved_at DateTime?

  @@index([post_id, reported_by])
  @@index([reported_by])
  @@index([pid])
  @@index([created_at])
  @@map("reports")
}

enum AutomodRuleType {
  keyword
}

enum AutomodRuleMode {
  block
  log
}

enum AutomodAction {
  blocked
  logged
}

model AutomodRule {
  id              String  @id @default(uuid())
  legacy_mongo_id String? @unique

  enabled     Boolean
  created_at  DateTime
  title       String
  description String?
  type        AutomodRuleType
  mode        AutomodRuleMode
  /// Settings of a `keyword` rule
  keywords    String[] @default([])

  @@index([enabled])
  @@map("automod_rules")
}

model AutomodLog {
  id              String  @id @default(uuid())
  legacy_mongo_id String? @unique

  rule_id           String
  created_at        DateTime
  author            Int
  action            AutomodAction
  post_id           String?
  parent_post_id    String?
  community_id      String?
  /// [{ start, end }] character ranges of the body that matched the rule
  matches           Json?
  post_content_body String?

  @@index([author])
  @@index([action, created_at])
  @@index([created_at])
  @@map("automod_logs")
}

enum AuditLogAction {
  REMOVE_POST
  IGNORE_REPORT
  LIMIT_POSTING
  TEMP_BAN
  PERMA_BAN
  UNBAN
  UPDATE_USER
  MAKE_COMMUNITY
  UPDATE_COMMUNITY
  DELETE_COMMUNITY
}

/// Moderation audit log (was the Mongo `logs` collection)
model AuditLog {
  id              String  @id @default(uuid())
  legacy_mongo_id String? @unique

  actor          Int
  action         AuditLogAction
  target         String
  context        String
  timestamp      DateTime @default(now())
  changed_fields String[] @default([])

  @@index([target])
  @@index([action])
  @@index([actor])
  @@index([timestamp])
  @@map("audit_logs")
}
